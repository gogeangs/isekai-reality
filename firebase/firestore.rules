rules_version = '2';
// 묶음 55 #245: 내 기록(users/{내 uid})과 그 아래 조각만 읽고 쓴다. 다른 사람 것은 못 봄.
// 묶음 53(운영정책): 계정 상태(status/{uid}: 제재 단계 등)는 내 것만 읽고, 쓰기는 운영 도구(관리자)만.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{rest=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
    match /status/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // 묶음 68 #275: 대화 · 친구 · 신고는 서버 함수로만 읽고 쓴다
    // (그 방 사람인지 · 차단 · 금칙어 · 개인정보 가림 · 도배 · 대화 금지를 서버가 확인)
    match /chatRooms/{room}/{rest=**} { allow read, write: if false; }
    match /chatUser/{uid} { allow read, write: if false; }
    match /friendCode/{code} { allow read, write: if false; }
    match /invites/{uid} { allow read, write: if false; }
    match /friendReq/{id} { allow read, write: if false; }
    match /chatReport/{id} { allow read, write: if false; }
  }
}
